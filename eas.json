{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_OZIRA_ENV": "staging" },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_OZIRA_ENV": "staging" },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "extends": "preview"
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_OZIRA_ENV": "production" }
    }
  }
}
